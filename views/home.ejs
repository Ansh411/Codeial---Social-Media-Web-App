<link rel="stylesheet" href="/css/home.css">

<div id="home-container">
  <section id="feed-posts">
<h3>Posts</h3>
<% if (locals.user) { %>
<form action="/posts/create" id="new-post-form" method="post" enctype="multipart/form-data" class="create-post-form">
  <textarea name="content" id="post-content" placeholder="What's on your mind?" required></textarea>

  <div class="upload-section">
    <label for="post-image" class="upload-label">
      📸 Add Image
    </label>
    <input type="file" id="post-image" name="image" accept="image/*" style="display:none">
    <img id="image-preview" src="" alt="Preview" class="hidden">
  </div>

  <button type="submit" class="share-btn">Share 🚀</button>
</form>

<% } %>


    <div id="posts-list-container">
      <ul>
        <% for (post of posts) { %>
          <%- include('_post') -%>
        <% } %>
      </ul>
    </div>
  </section>

  <section id="users-friends">
    <h4>Friends</h4>
    <div id="friends-list">
      <% if (locals.friends && friends.length > 0) { %>
        <% for(friendship of friends) { %>
          <% let friend = (friendship.from_user._id.toString() === user._id.toString()) ? friendship.to_user : friendship.from_user; %>
          <p><a href="/users/profile/<%= friend._id %>"><%= friend.name %></a></p>
        <% } %>
      <% } else { %>
        <p>No friends yet 👀</p>
      <% } %>
    </div>

    <hr>

    <h4>All Users</h4>
    <div id="all-users-list">
      <% for(u of all_users) { %>
        <% if (!locals.user || user.id !== u.id) { %>
          <p>
            <a href="/users/profile/<%= u.id %>"><%= u.name %></a>
          </p>
        <% } %>
      <% } %>
    </div>
    <div id="sidebar-chat-wrapper">
      <%- include('_chat_box') -%>
    </div>
  </section>
</div>

<script src="/js/home_post_comments.js"></script>
<script src="/js/home_posts.js"></script>
<script>
  // --- Instant image preview ---
  const postImageInput = document.getElementById('post-image');
  const preview = document.getElementById('image-preview');
  
  if (postImageInput) {
    postImageInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) {
        preview.src = "";
        preview.classList.add('hidden');
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        preview.src = reader.result;
        preview.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    });
  }
</script>

<script src="/js/toggle_likes.js"></script>
<script>
  $('.toggle-like-button').each(function () {
    let self = this;
    new ToggleLike(self);
  });
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.8.1/socket.io.js"></script>
<script src="/js/chat_engine.js"></script>

<% if(locals.user) { %>
<script>
  new ChatEngine('user-chat-box', '<%= locals.user.email %>', '<%= locals.user.name %>')
</script>
<% } %>


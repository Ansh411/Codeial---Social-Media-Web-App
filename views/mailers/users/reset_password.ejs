<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= isMailTemplate ? 'Reset Your Password' : 'Set a New Password' %></title>
  <style>
    body {
      background-color: #f4f4f4;
      font-family: Arial, sans-serif;
      color: #333;
      padding: 20px;
    }
    .container {
      background-color: #fff;
      border-radius: 10px;
      max-width: 500px;
      margin: auto;
      padding: 30px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      text-align: center;
    }
    h2 {
      color: #222;
    }
    a.button, input[type="submit"] {
      display: inline-block;
      background-color: #8458B3;
      color: white;
      padding: 10px 20px;
      margin-top: 20px;
      text-decoration: none;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    a.button:hover, input[type="submit"]:hover {
      background-color: #926abd;
    }
    p {
      margin: 15px 0;
    }
    form {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      margin-top: 20px;
    }
    input[type="password"] {
      padding: 10px;
      width: 80%;
      border-radius: 5px;
      border: 1px solid #ccc;
    }
  </style>
</head>
<body>

  <% if (isMailTemplate) { %>
    <!-- 📧 EMAIL VERSION -->
    <div class="container">
      <h2>Password Reset Request</h2>
      <p>Hello <%= user.name %>,</p>
      <p>You requested to reset your password for your Codeial account.</p>
      <p>Click the button below to set a new password:</p>
      <a class="button" href="http://localhost:8000/users/reset-password/<%= accessToken %>">Reset Password</a>
      <p>If you didn’t request this, you can safely ignore this email.</p>
    </div>

  <% } else { %>
    <!-- 🌐 WEB FORM VERSION -->
    <div class="container">
      <h2>Set a New Password</h2>
      <form action="/users/update-password/<%= accessToken %>" method="POST">
        <input type="password" name="new_password" placeholder="New Password" required>
        <input type="password" name="confirm_password" placeholder="Confirm Password" required>
        <input type="submit" value="Update Password">
      </form>
    </div>
  <% } %>

</body>
</html>
